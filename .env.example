# --- básico -----------------------------------------------------------------
PORT=3000
# En Railway: /data, con un volumen persistente. Sin esto la base se pierde en
# cada redeploy, igual que en Aperturas.
DATA_DIR=/data

# Contraseña única para entrar al tablero. Mínimo 8 caracteres.
APP_PASSWORD=cambiame

# --- webhook del sistema de ventas ------------------------------------------
# Hay que setear UNA de las dos. Sin ninguna, el webhook rechaza todo: no se
# aceptan ventas sin autenticar ni siquiera en desarrollo.
#
# Preferida: el proveedor firma el cuerpo crudo con HMAC-SHA256 y manda el hex
# en el header x-temple-firma.
HOOK_SECRET=
# Alternativa para proveedores que sólo saben mandar un header fijo.
HOOK_TOKEN=

# Qué adaptador traduce el payload del proveedor. Ver adaptadores.js.
POS_ADAPTADOR=generico

# --- simulador --------------------------------------------------------------
# Genera ventas falsas para probar el circuito entero sin el POS conectado.
# Quedan marcadas con origen='simulador' y se borran con un endpoint.
SIMULADOR=0
# 1 = tiempo real. Subilo para ver un día entero en minutos.
SIMULADOR_VELOCIDAD=1
# Hay que ponerlo en 1 para permitir el simulador con NODE_ENV=production.
SIMULADOR_EN_PROD=0
